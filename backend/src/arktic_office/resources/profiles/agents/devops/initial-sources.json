{
  "max_files": 11,
  "max_bytes": 10500,
  "max_file_bytes": 1600,
  "groups": [
    {"id": "root-manifests", "take": 2, "patterns": ["package.json", "pom.xml", "build.gradle*", "pyproject.toml", "requirements*.txt", "go.mod", "Cargo.toml", "*.sln"]},
    {"id": "tasks", "take": 1, "patterns": ["turbo.json", "settings.gradle*", "Makefile", "Taskfile.y*ml", "tox.ini", "noxfile.py"]},
    {"id": "applications", "take": 3, "patterns": ["apps/*/package.json", "services/*/package.json", "*/pom.xml", "*/build.gradle*", "*/pyproject.toml", "*/requirements*.txt"]},
    {"id": "startup-config", "take": 1, "patterns": ["**/env.[jt]s", "**/settings.py", "**/entrypoint.sh", "**/start.sh", "**/instrumentation.[jt]s"], "anchor": "(?i)process\\.env|validat|environ|^#!"},
    {"id": "compose", "take": 1, "patterns": ["compose.y*ml", "docker-compose.y*ml"]},
    {"id": "migration-image", "take": 1, "patterns": ["**/database/Dockerfile*", "**/migrations/Dockerfile*", "**/Dockerfile*migrat*"], "anchor": "(?i)^FROM.* AS runner|^ENTRYPOINT|^CMD"},
    {"id": "readme", "take": 1, "patterns": ["README*", "**/README*"], "anchor": "(?i)^#{1,4}.*(?:arranque|instalaci[oó]n|getting started|local|quick start|desarrollo)"},
    {"id": "env-examples", "take": 2, "patterns": ["**/.env.example", "**/.env.sample", "**/.env.template"]},
    {"id": "deployment", "take": 2, "patterns": ["**/Dockerfile*", ".github/workflows/*.y*ml", ".gitlab-ci.yml", "azure-pipelines.y*ml", "Jenkinsfile"]}
  ]
}
