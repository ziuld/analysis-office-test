{
  "max_files": 5,
  "max_bytes": 4400,
  "max_file_bytes": 1150,
  "groups": [
    {"id": "authentication", "take": 1, "patterns": ["**/src/auth.[jt]s", "**/auth.[jt]s", "**/*SecurityConfig.java", "**/authentication.py", "**/security.py", "**/auth.py"]},
    {"id": "authorization", "take": 1, "patterns": ["**/auth.config.[jt]s", "**/permissions.[jt]s", "**/permissions.py", "**/middleware.[jt]s"]},
    {"id": "credentials-and-sessions", "take": 2, "patterns": ["**/login.[jt]s", "**/session.[jt]s", "**/sessions.py", "**/*SessionService.java", "**/*AuthController.java", "**/app/api/auth/**/route.[jt]s"]},
    {"id": "identity-docs", "take": 1, "patterns": ["docs/security/README*", "docs/auth*.md", "README*"], "anchor": "(?i)^#{1,4}.*(?:auth|sesión|session|acceso|seguridad)"}
  ]
}
