    {"id": "component-map", "take": 1, "patterns": ["docs/architecture/README*", "docs/architecture*.md", "README*", "docker-compose.y*ml", "compose.y*ml"], "anchor": "(?i)^#{1,4}.*(?:arquitectura|architecture|estructura|structure|component)"}
