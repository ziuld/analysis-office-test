# ChatGPT Plus: iniciar sesión en Hermes mediante OAuth, sin clave API.
AUDIT_PROVIDER=openai-codex
AUDIT_MODEL=gpt-6.1-sol
AUDIT_REASONING=medium
# Techo solicitado para API; Hermes no lo envía al backend Codex OAuth.
AUDIT_MAX_OUTPUT_TOKENS=8000
AUDIT_MAX_FILES=24
AUDIT_MAX_TOTAL_BYTES=120000
# Solo helpers legacy: pasadas adicionales de exploración: 0 = inicial; 1 = hasta dos pasadas.
# 2 = hasta tres, 3 = hasta cuatro. Rango 0–20; tiempo/contexto pueden cortar antes.
AUDIT_PREPARATION_MAX_LOOPS=1
# 0 permite pruebas reales de modelos sin ejecutar scanners; 1 conserva el comportamiento anterior.
AUDIT_SCANNERS_ENABLED=1
# ai: encargos iniciales y síntesis; deterministic omite el modelo coordinador.
AUDIT_COORDINATION_MODE=ai
# Encargo: vacío omite propuestas Azure; azure las solicita a Arquitectura.
AUDIT_CAPABILITIES=
# Opcional: ajustar una célula sin subir las demás (vacío = configuración común).
AUDIT_SECURITY_MODEL=
AUDIT_SECURITY_REASONING=
AUDIT_ARCHITECTURE_MODEL=
AUDIT_ARCHITECTURE_REASONING=
AUDIT_INVENTORY_MODEL=
AUDIT_INVENTORY_REASONING=
# Solo para AUDIT_PROVIDER=openai (API con facturación independiente).
OPENAI_API_KEY=
# Opcional para repositorios privados: token de GitHub con acceso solo de lectura.
GITHUB_TOKEN=

# Variables históricas del reparto anterior; sin efecto en el recorrido compartido.
AUDIT_COORDINATOR_MAX_EXTRA_QUERIES=0
AUDIT_SECURITY_MAX_EXTRA_QUERIES=0
AUDIT_ARCHITECTURE_MAX_EXTRA_QUERIES=0
AUDIT_INVENTORY_MAX_EXTRA_QUERIES=0
# Snapshot íntegro: si supera capacidad se detiene, sin muestrear.
AUDIT_SNAPSHOT_MAX_BYTES=32000000
AUDIT_SNAPSHOT_MAX_FILES=20000
AUDIT_SNAPSHOT_SECONDS=300
# Reutiliza preparación válida por repositorio/commit y versiones de herramientas.
# 1 fuerza regenerarla (también actualiza las consultas de vulnerabilidades OSV).
AUDIT_PREPARATION_REFRESH=0
# Investigación de especialistas: rondas de consultas 0–20, más una respuesta final.
# Elegir fuentes es autónomo. Con rondas > 0 se exige leer fuentes antes del cierre.
# 0 desactiva la investigación; no usar para una revisión de código completa.
AUDIT_SECURITY_RESEARCH_ROUNDS=12
AUDIT_ARCHITECTURE_RESEARCH_ROUNDS=8
AUDIT_INVENTORY_RESEARCH_ROUNDS=6
