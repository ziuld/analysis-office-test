+++ b/src/features/audit/AuditOffice.tsx
@@ -0,0 +1,130 @@
+"use client";
+
+import { useCallback, useEffect, useMemo, useState } from "react";
+import ReactMarkdown from "react-markdown";
+import remarkGfm from "remark-gfm";
+import { PixelOffice2D } from "@/features/pixel-office/PixelOffice2D";
+import type { OfficeAgent } from "@/features/retro-office/core/types";
+import { AgentQuestion, type Question } from "./AgentQuestion";
+import { ExecutiveReport } from "./ExecutiveReport";
+
+interface Cell { id: string; nombre: string; estado: string; model: string; reasoning: string; error?: string; mensaje?: string; necesita?: string[]; coverage?: string; reason?: string; missing?: string[] }
+interface Activity { state: string; text: string; working: boolean; meeting: boolean }
+interface Run { activity?: Record<string, Activity>; id: string; repository: string; estado: string; commit?: string; branch?: string; celulas: Cell[]; error?: string; mensaje?: string; necesita?: string[]; has_report: boolean; historical?: boolean; evidence_origin?: string; report_format?: number; derived_from?: string; simulation?: boolean }
+const roles = [{ id: "coordinator", name: "Coordinador", color: "#38bdf8" }, { id: "security", name: "Seguridad", color: "#fbbf24" }, { id: "architecture", name: "Arquitectura", color: "#a78bfa" }, { id: "inventory", name: "Inventario", color: "#34d399" }];
+const busy = (state?: string) => state === "preparando" || state === "analizando";
+import { statusLabel as label, avatarStatus } from "./auditStatus";
+
+async function api(path: string, init?: RequestInit) {
+  const response = await fetch("/api/audit/" + path, { cache: "no-store", ...init });
+  const data = await response.json();
+  if (!response.ok) throw new Error(data.error || "No se pudo completar la solicitud.");
+  return data;
+}
+
+export function AuditOffice() {
+  const [repository, setRepository] = useState("");
+  const [runs, setRuns] = useState<Run[]>([]);
+  const [selected, setSelected] = useState<string | null>(null);
+  const [connected, setConnected] = useState(false);
+  const [error, setError] = useState("");
+  const [networkError, setNetworkError] = useState("");
+  const [submitting, setSubmitting] = useState(false);
+  const [panel, setPanel] = useState(true);
+  const [report, setReport] = useState<string | null>(null);
+  const [reportHtml, setReportHtml] = useState<string | null>(null);
+  const [selectedCell, setSelectedCell] = useState("coordinator");
+  const [chat, setChat] = useState<{ run: Run; agent: string } | null>(null);
+  const [questionActive, setQuestionActive] = useState<Question | null>(null);
+  const current = runs.find(r => r.id === selected) || runs[0];
+  const active = runs.find(r => busy(r.estado));
+
+  const refresh = useCallback(async () => {
+    try {
+      const data = await api("runs");
+      setRuns(data.runs); setQuestionActive(data.question_active || null); setConnected(true); setNetworkError("");
+    } catch (e) { setConnected(false); setNetworkError(e instanceof Error ? e.message : "Servicio no disponible."); }
+  }, []);
+  useEffect(() => { void refresh(); const timer = window.setInterval(() => void refresh(), 2000); return () => window.clearInterval(timer); }, [refresh]);
+
+  // Avatars always represent the active job, even while viewing an older report.
+  const live = active || runs[0];
+  const agents = useMemo<OfficeAgent[]>(() => roles.map(role => {
+    const cell = live?.celulas?.find(c => c.id === role.id);
+    const state = questionActive?.agent === role.id ? "analizando" : live?.activity?.[role.id]?.state || (role.id === "coordinator" ? live?.estado : cell?.estado);
+    return { ...role, subtitle: label[state || ""] || "En espera", item: "coding", status: avatarStatus(connected, state) };
+  }), [live, connected, questionActive]);
+
+  const activityText = Object.fromEntries(roles.map(role => [role.id, !connected ? "" : questionActive?.agent === role.id ? "Consultando evidencia guardada" : live?.activity?.[role.id]?.working ? live?.activity?.[role.id]?.text || "" : ""]));
+
+  async function start(event: React.FormEvent) {
+    event.preventDefault(); setSubmitting(true); setError(""); setReport(null);
+    try {
+      const run = await api("runs", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ repository }) });
+      setSelected(run.id); await refresh();
+    } catch (e) { setError(e instanceof Error ? e.message : "No se pudo iniciar la revisión."); }
+    finally { setSubmitting(false); }
+  }
+
+  async function openReport() {
+    if (!current) return;
+    try { const data = await api(`runs/${current.id}/report`); setReportHtml(data.html || null); setReport(data.text); }
+    catch (e) { setError(e instanceof Error ? e.message : "Informe no disponible."); }
+  }
+
+  function consult(agent: string) {
+    if (current?.simulation) { setError("Ejemplo ficticio: consultas desactivadas. No consume tokens."); return; }
+    setSelectedCell(agent); setPanel(true);
+    if (current?.estado === "informacion_insuficiente" || current?.celulas?.find(c => c.id === agent)?.estado === "informacion_insuficiente") return;
+    if (current?.has_report && !busy(current.estado)) setChat({ run: current, agent });
+    else setError("Selecciona una revisión terminada con informe para consultar al equipo.");
+  }
+
+  return <div className="relative h-full w-full bg-slate-950 text-slate-100">
+    <div className={`absolute inset-x-0 top-14 ${panel ? "bottom-1/2 min-[1000px]:bottom-0 min-[1000px]:right-[380px]" : "bottom-0"}`}>
+      <PixelOffice2D agents={agents} renderMode="2d" onRenderModeChange={() => {}} readOnly compact
+        onAgentChatSelect={consult} selectedAgentId={chat?.agent || selectedCell} statusTextByAgentId={activityText}
+        meetingActive={connected && !!live?.activity?.coordinator?.meeting}
+        officeTitle="Equipo de análisis" officeTitleLoaded gatewayStatus={connected ? "connected" : "disconnected"} activeAdapterType="hermes"
+        remoteOfficeEnabled={false} remoteOfficeSourceKind="presence_endpoint" remoteOfficeLabel="" remoteOfficePresenceUrl="" remoteOfficeGatewayUrl="" remoteOfficeTokenConfigured={false}
+        voiceRepliesEnabled={false} voiceRepliesVoiceId={null} voiceRepliesSpeed={1} voiceRepliesLoaded />
+    </div>
+    <header className="absolute inset-x-0 top-0 z-30 flex h-14 items-center justify-between border-b border-white/10 bg-slate-950 px-5">
+      <div className="flex items-center gap-3"><strong className="text-lg font-black tracking-tight">ARKTIC<span className="text-[#42bcc6]">.</span></strong><span className="hidden border-l border-white/20 pl-3 text-xs text-slate-300 sm:block">Oficina de análisis</span><span className="text-xs text-slate-400" aria-label="Versión de la oficina">v{process.env.NEXT_PUBLIC_OFFICE_VERSION || "development"}</span></div>
+      <button className="rounded-lg bg-[#42bcc6] px-4 py-2 text-sm font-semibold text-slate-950" onClick={() => setPanel(!panel)}>{panel ? "Ver oficina" : "Abrir revisión"}</button>
+    </header>
+    {panel && <aside aria-label="Panel de revisión" className="absolute bottom-3 left-3 right-3 top-1/2 z-30 overflow-auto rounded-xl border border-white/15 bg-slate-950/95 p-5 shadow-2xl min-[1000px]:left-auto min-[1000px]:top-16 min-[1000px]:w-[356px]">
+      <h1 className="text-xl font-semibold">Revisión de repositorio</h1>
+      <p className="mt-1 text-sm text-slate-400">Solo lectura de la <strong>rama predeterminada</strong>, ligada a un commit. El arquitecto evalúa el resultado.</p>
+      <form onSubmit={start} className="mt-5 space-y-3">
