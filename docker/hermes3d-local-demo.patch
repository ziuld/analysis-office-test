+import { describe, expect, it } from "vitest";
+import { buildArkticOfficeMap } from "@/features/pixel-office/map/arkticOfficeMap";
+import { buildPixelNavGrid, tileCenter } from "@/features/pixel-office/map/navGrid";
+import { createPixelSimulation } from "@/features/pixel-office/sim/agentSimulation";
+import { OBJECT_FOOTPRINT, type PixelAgentInput } from "@/features/pixel-office/types";
+import { astar2D } from "@/lib/office/pathfinding";
+
+describe("compact Arktic office", () => {
+  it("measures fewer idle trips on the same map with unchanged walking speed", () => {
+    const map = buildArkticOfficeMap();
+    const measure = (oldTiming: boolean) => {
+      const sim = createPixelSimulation(map, oldTiming ? { idlePauseMinMs: 4000, idlePauseRangeMs: 6000 } : {});
+      const inputs: PixelAgentInput[] = ["coordinator", "inventory", "architecture", "data", "identity", "frontend-security", "backend-security", "devops"].map(id => ({
+        id, name: id, color: "#42bcc6", status: "idle", controlled: true, streaming: false, thinking: false,
+        awaitingApproval: false, dancing: false, hold: null, standup: false,
+      }));
+      const last = new Map<string, string>();
+      let trips = 0;
+      for (let tick = 0; tick < 6000; tick++) {
+        sim.tick({ inputs, nowMs: tick * 100, dtMs: 100, cleaningActive: false });
+        for (const agent of Object.values(sim.getState().agents)) {
+          if (agent.goalStationId && agent.goalStationId !== last.get(agent.id)) {
+            if (tick > 100) trips++;
+            last.set(agent.id, agent.goalStationId);
+          }
+        }
+      }
+      return trips;
+    };
+    const before = measure(true), after = measure(false);
+    console.info("idle-trips-600-seconds", JSON.stringify({ before, after, ratio: after / before }));
+    expect(after / before).toBeGreaterThan(0.2);
+    expect(after / before).toBeLessThan(0.5);
+  });
+  it("keeps furniture within the map and outside the enclosing walls", () => {
+    const map = buildArkticOfficeMap();
+    for (const object of map.objects) {
+      const [w, h] = OBJECT_FOOTPRINT[object.kind];
+      expect(object.tx).toBeGreaterThan(1);
+      expect(object.ty).toBeGreaterThan(1);
+      expect(object.tx + w).toBeLessThanOrEqual(map.cols - 2);
+      expect(object.ty + h).toBeLessThanOrEqual(map.rows - 2);
+    }
+  });
+
+  it("connects all eight desks and every room station to the entrance", () => {
+    const map = buildArkticOfficeMap();
+    expect(map.desks).toHaveLength(8);
+    const grid = buildPixelNavGrid(map);
+    const start = tileCenter(map.spawn.tx, map.spawn.ty);
+    const targets = [...map.stations.map(s => [s.tx, s.ty]), ...map.desks.map(d => [d.seatTx, d.seatTy])];
+    for (const [tx, ty] of targets) {
+      const end = tileCenter(tx, ty);
+      expect(astar2D(start.x, start.y, end.x, end.y, grid).length, `unreachable ${tx},${ty}`).toBeGreaterThan(0);
+    }
+  });
+
+  it("seats Akira in the room, keeps overflow at desks and releases everyone", () => {
+    const map = buildArkticOfficeMap();
+    const sim = createPixelSimulation(map);
+    const ids = ["inventory", "architecture", "data", "identity", "frontend-security", "backend-security", "devops", "coordinator"];
+    const inputs: PixelAgentInput[] = ids.map(id => ({ id, name: id, color: "#42bcc6", status: "idle", controlled: true,
+      streaming: false, thinking: false, awaitingApproval: false, dancing: false, hold: null, standup: true }));
+    let poses = sim.tick({ inputs, nowMs: 0, dtMs: 50, cleaningActive: false });
+    for (let tick = 1; tick < 2000; tick++) poses = sim.tick({ inputs, nowMs: tick * 50, dtMs: 50, cleaningActive: false });
+    expect(poses.every(p => p.activity === "meeting" && !p.moving)).toBe(true);
+    expect(poses.find(p => p.id === "coordinator")?.stationId).toBe("review-1");
+    expect(poses.filter(p => p.stationId?.startsWith("review-"))).toHaveLength(4);
+    expect(new Set(poses.map(p => `${p.x}:${p.y}`)).size).toBe(8);
+    const seats = poses.map(p => p.stationId);
+    poses = sim.tick({ inputs: [...inputs].reverse(), nowMs: 100050, dtMs: 50, cleaningActive: false });
+    expect(poses.map(p => p.stationId).reverse()).toEqual(seats);
+    for (const input of inputs) input.standup = false;
+    poses = sim.tick({ inputs, nowMs: 100100, dtMs: 50, cleaningActive: false });
+    expect(poses.every(p => p.activity !== "meeting" && p.activity !== "sitting_desk")).toBe(true);
+  });
+
+  it("lets the four working agents reach different computer seats", () => {
+    const sim = createPixelSimulation(buildArkticOfficeMap());
+    const inputs: PixelAgentInput[] = ["coordinator", "security", "architecture", "inventory"].map(id => ({
+      id, name: id, color: "#42bcc6", status: "working", streaming: false,
+      thinking: false, awaitingApproval: false, dancing: false, hold: null, standup: false,
+    }));
+    let poses = sim.tick({ inputs, nowMs: 100000, dtMs: 50, cleaningActive: false });
+    for (let tick = 1; tick < 1600; tick++)
+      poses = sim.tick({ inputs, nowMs: 100000 + tick * 50, dtMs: 50, cleaningActive: false });
+    expect(poses).toHaveLength(4);
+    expect(poses.every(p => p.activity === "sitting_desk" && !p.moving)).toBe(true);
+    expect(new Set(poses.map(p => p.deskId)).size).toBe(4);
+  });
+
+  it("keeps desk orientation during work and releases finished agents", () => {
+    for (const finishedStatus of ["idle", "error"] as const) {
+      const sim = createPixelSimulation(buildArkticOfficeMap());
+      const inputs: PixelAgentInput[] = ["coordinator", "security"].map(id => ({
+        id, name: id, color: "#42bcc6", status: "working", controlled: true, selected: false,
+        streaming: false, thinking: false, awaitingApproval: false, dancing: false, hold: null, standup: false,
+      }));
+      let poses = sim.tick({ inputs, nowMs: 0, dtMs: 50, cleaningActive: false });
+      for (let tick = 1; tick < 1000; tick++) poses = sim.tick({ inputs, nowMs: tick * 50, dtMs: 50, cleaningActive: false });
+      const parked = poses.map(p => [p.x, p.y]);
+      const facing = poses.map(p => p.facing);
+      inputs[1].selected = true;
+      for (let tick = 1000; tick < 1200; tick++) poses = sim.tick({ inputs, nowMs: tick * 50, dtMs: 50, cleaningActive: false });
+      expect(poses.map(p => [p.x, p.y])).toEqual(parked);
+      expect(poses.map(p => p.facing)).toEqual(facing);
+      for (const input of inputs) input.status = finishedStatus;
+      let leftDesk = false;
+      for (let tick = 1200; tick < 4200; tick++) {
+        poses = sim.tick({ inputs, nowMs: tick * 50, dtMs: 50, cleaningActive: false });
+        if (poses.some((p, i) => p.x !== parked[i][0] || p.y !== parked[i][1])) leftDesk = true;
+      }
+      expect(leftDesk).toBe(true);
+      expect(Object.values(sim.getState().agents).every(a => a.goalKind !== "desk")).toBe(true);
+    }
+  });
+
+  it("holds an ambient desk visit for triple the pause and interrupts it for real work", () => {
+    const map = buildArkticOfficeMap();
+    map.stations = [];
+    const sim = createPixelSimulation(map, { idlePauseMinMs: 1000, idlePauseRangeMs: 0 });
+    const inputs: PixelAgentInput[] = [{ id: "coordinator", name: "Akira", color: "#42bcc6", status: "idle", controlled: true,
+      streaming: false, thinking: false, awaitingApproval: false, dancing: false, hold: null, standup: false }];
+    let nowMs = 0;
+    while (!sim.getState().agents.coordinator?.pauseUntil && nowMs < 20000) {
+      sim.tick({ inputs, nowMs, dtMs: 50, cleaningActive: false });
+      nowMs += 50;
+    }
+    expect(sim.getState().agents.coordinator.pauseUntil).toBe(nowMs - 50 + 3000);
+    expect(sim.getState().agents.coordinator.goalStationId).toMatch(/^idle-desk:/);
+    inputs[0].status = "working";
+    const poses = sim.tick({ inputs, nowMs, dtMs: 50, cleaningActive: false });
+    expect(sim.getState().agents.coordinator.goalKind).toBe("desk");
+    expect(sim.getState().agents.coordinator.pauseUntil).toBe(0);
+    expect(poses[0].activity).toBe("sitting_desk");
+  });
+
+  it("keeps stopped bodies separated through crowded idle, work and meetings including cleaning", () => {
+    const sim = createPixelSimulation(buildArkticOfficeMap());
+    const inputs: PixelAgentInput[] = Array.from({length: 12}, (_, i) => ({ id: `person-${i}`, name: `${i}`, color: "#42bcc6", status: "idle", controlled: true,
+      streaming: false, thinking: false, awaitingApproval: false, dancing: false, hold: null, standup: false }));
+    for (let tick = 0; tick < 3000; tick++) {
+      for (const [i, input] of inputs.entries()) {
+        input.status = tick >= 1000 && tick < 1800 && i < 4 ? "working" : "idle";
+        input.standup = tick >= 1800 && tick < 2400 && i < 8;
+      }
+      const poses = sim.tick({ inputs, nowMs: tick * 100, dtMs: 100, cleaningActive: tick < 2600 });
+      const stopped = poses.filter(p => !p.moving);
+      for (let i = 0; i < stopped.length; i++) for (let j = i + 1; j < stopped.length; j++) {
+        expect(Math.hypot(stopped[i].x - stopped[j].x, stopped[i].y - stopped[j].y), `tick ${tick}: ${stopped[i].id}/${stopped[j].id}`).toBeGreaterThanOrEqual(30);
+      }
+    }
+  });
+});
