+// Compact consulting office. Grow this map when a real team needs more seats.
+// Reuses the upstream furniture, navigation and character simulation.
+import type { PixelGroundTile, PixelMapObject, PixelObjectKind, PixelOfficeMap } from "@/features/pixel-office/types";
+
+export const buildArkticOfficeMap = (): PixelOfficeMap => {
+  const cols = 28, rows = 22;
+  const ground: PixelGroundTile[] = new Array(cols * rows).fill("void");
+  const rect = (tile: PixelGroundTile, x: number, y: number, w: number, h: number) => {
+    for (let ty = y; ty < y + h; ty++)
+      for (let tx = x; tx < x + w; tx++) ground[ty * cols + tx] = tile;
+  };
+  rect("floor_cream", 2, 2, 24, 18);
+  rect("floor_white", 2, 2, 15, 16);
+  rect("floor_wood", 18, 2, 8, 9);
+  rect("kitchen_tile", 18, 12, 8, 6);
+  rect("wall", 1, 1, 26, 1);
+  rect("wall", 1, 20, 26, 1);
+  rect("wall", 1, 2, 1, 18);
+  rect("wall", 26, 2, 1, 18);
+  rect("wall", 17, 2, 1, 16);
+  rect("wall", 18, 11, 8, 1);
+  // Generous doorways connect every room to the shared circulation space.
+  rect("floor_cream", 17, 8, 1, 2);
+  rect("floor_cream", 17, 15, 1, 2);
+  rect("path", 8, 20, 3, 1);
+  for (const x of [4, 5, 10, 11, 20, 21, 23, 24]) rect("wall_window", x, 1, 1, 1);
+
+  const objects: PixelMapObject[] = [];
+  const put = (kind: PixelObjectKind, tx: number, ty: number, blocking?: boolean) =>
+    objects.push({ id: `${kind}-${tx}-${ty}`, kind, tx, ty, ...(blocking === undefined ? {} : { blocking }) });
+  const desks = [[4, 4], [8, 4], [12, 4], [4, 8], [8, 8], [12, 8], [4, 12], [10, 12]].map(([x, y], i) => {
+    put("desk_monitor", x, y);
+    put("chair", x, y + 1, false);
+    return { id: `arktic-desk-${i + 1}`, deskTx: x, deskTy: y, seatTx: x, seatTy: y + 1, facing: "up" as const };
+  });
+  put("plant_tall", 2, 2);
+  put("plant", 15, 16);
+  put("bookshelf", 3, 16);
+  put("whiteboard", 20, 3);
+  put("meeting_table", 20, 6);
+  for (const [x, y] of [[20, 5], [22, 5], [20, 8], [22, 8]]) put("chair", x, y, false);
+  put("plant", 25, 10);
+  put("kitchen_counter", 19, 13);
+  put("coffee_machine", 22, 13);
+  put("fridge", 24, 13);
+  put("sofa_h", 20, 17);
+  put("coffee_table", 23, 17);
+  put("plant_tall", 2, 19);
+  put("plant", 25, 19);
+
+  return {
+    cols, rows, ground, objects, desks,
+    zones: [
+      { id: "analysis", kind: "team_pod", label: "Análisis de código", tx: 2, ty: 2, tw: 15, th: 16 },
+      { id: "review", kind: "meeting", label: "Revisión", tx: 18, ty: 2, tw: 8, th: 9 },
+      { id: "coffee", kind: "kitchen", label: "Café", tx: 18, ty: 12, tw: 8, th: 6 },
+    ],
+    stations: [
+      { id: "review-1", kind: "meeting_seat", tx: 20, ty: 5, facing: "down" },
+      { id: "review-2", kind: "meeting_seat", tx: 22, ty: 5, facing: "down" },
+      { id: "review-3", kind: "meeting_seat", tx: 20, ty: 8, facing: "up" },
+      { id: "review-4", kind: "meeting_seat", tx: 22, ty: 8, facing: "up" },
+      { id: "coffee-1", kind: "coffee", tx: 22, ty: 14, facing: "up" },
+      { id: "coffee-2", kind: "coffee", tx: 24, ty: 14, facing: "up" },
+      { id: "lounge-1", kind: "lounge_seat", tx: 20, ty: 17, facing: "down" },
+      { id: "lounge-2", kind: "lounge_seat", tx: 21, ty: 17, facing: "down" },
+      { id: "library-1", kind: "library", tx: 4, ty: 17, facing: "up" },
+      { id: "hall-1", kind: "wander", tx: 10, ty: 18, facing: "up" },
+      { id: "hall-2", kind: "wander", tx: 14, ty: 10, facing: "left" },
+    ],
+    spawn: { tx: 9, ty: 19 },
+  };
+};
