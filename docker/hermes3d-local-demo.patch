+++ b/src/features/audit/ExecutiveReport.tsx
@@ -0,0 +1,54 @@
+"use client";
+
+import { useRef, useState } from "react";
+
+export function ExecutiveReport({ html }: { html: string }) {
+  const frame = useRef<HTMLIFrameElement>(null);
+  const [filter, setFilter] = useState("all");
+  const rules: Record<string, string> = {
+    all: "",
+    urgent: ".risk:not(.critica):not(.alta){display:none}",
+    pending: ".risk:not(.pending){display:none}",
+    confirmed: ".risk:not(.confirmed){display:none}",
+  };
+  const source = html.replace(/<script id="arktic-report-navigation">[\s\S]*?<\/script>/g, "").replace("</head>", `<style>@media screen{${rules[filter]}}</style></head>`);
+  function bindNavigation() {
+    const doc = frame.current?.contentDocument;
+    if (!doc) return;
+    // The iframe cannot run scripts. This trusted parent handles internal anchors only.
+    doc.addEventListener("click", event => {
+      const anchor = (event.target as Element)?.closest?.('a[href^="#"]');
+      const href = anchor?.getAttribute("href");
+      if (!href) return;
+      let id;
+      try { id = decodeURIComponent(href.slice(1)); } catch { return; }
+      const target = doc.getElementById(id);
+      if (!target) return;
+      event.preventDefault();
+      for (let node: HTMLElement | null = target; node; node = node.parentElement) {
+        if (node.tagName === "DETAILS") (node as HTMLDetailsElement).open = true;
+        if (node.classList.contains("risk")) node.style.display = node.tagName === "TR" ? "table-row" : "block";
+      }
+      target.scrollIntoView({ block: "start" });
+      doc.querySelectorAll(".nav a").forEach(item => item.removeAttribute("aria-current"));
+      doc.querySelector(`.nav a[href="#${target.closest(".chapter")?.id || id}"]`)?.setAttribute("aria-current", "location");
+    });
+  }
+  function print() {
+    const doc = frame.current?.contentDocument;
+    if (doc) doc.querySelectorAll("details").forEach(detail => { detail.open = true; });
+    frame.current?.contentWindow?.print();
+  }
+  return <div className="flex min-h-0 flex-1 flex-col gap-3">
+    <div className="flex flex-wrap items-center gap-3 text-sm">
+      <label htmlFor="risk-filter">Ver riesgos</label>
+      <select id="risk-filter" className="rounded border border-white/20 bg-slate-900 p-2" value={filter} onChange={e => setFilter(e.target.value)}>
+        <option value="all">Todos</option><option value="urgent">🔴 Críticos y altos</option>
+        <option value="confirmed">Confirmados en código</option><option value="pending">Indicios por confirmar</option>
+      </select>
+      <button onClick={print} className="rounded bg-cyan-300 px-4 py-2 font-semibold text-slate-950">Imprimir / guardar PDF</button>
+      <span className="text-xs text-slate-400">La impresión incluye todos los hallazgos.</span>
+    </div>
+    <iframe ref={frame} onLoad={bindNavigation} title="Reporte ejecutivo de seguridad" sandbox="allow-same-origin allow-modals allow-popups allow-popups-to-escape-sandbox" srcDoc={source} className="min-h-0 flex-1 rounded-lg border-0 bg-white" />
+  </div>;
+}
