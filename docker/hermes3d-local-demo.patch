+"use client";
+
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import ReactMarkdown from "react-markdown";
+import remarkGfm from "remark-gfm";
+import { PixelOffice2D } from "@/features/pixel-office/PixelOffice2D";
+import type { OfficeAgent } from "@/features/retro-office/core/types";
+import { AgentQuestion, type Question } from "./AgentQuestion";
+import { ExecutiveReport } from "./ExecutiveReport";
+
+interface Cell { duration_seconds?: number; tokens_available?: number; summary?: string; usage?: Record<string, number>; id: string; nombre: string; estado: string; model: string; reasoning: string; error?: string; mensaje?: string; necesita?: string[]; coverage?: string; reason?: string; missing?: string[] }
+interface Activity { state: string; text: string; working: boolean; meeting: boolean }
+interface LocalSource { id: string; name: string; repository: string; branch: string; commit: string; source_path: string }
+interface Profile { id: string; person: string; name: string; color: string; model?: string; reasoning?: string }
+interface Run { coordination?: { profile?: { model: string; reasoning: string }; stages?: Record<string, { duration_seconds?: number; error?: string; usage?: Record<string, number> }>; question_answers?: { id: string; respuesta: string }[] }; meeting?: { active?: boolean; participants?: string[] }; activity?: Record<string, Activity>; id: string; repository: string; estado: string; commit?: string; branch?: string; celulas: Cell[]; error?: string; mensaje?: string; necesita?: string[]; has_report: boolean; has_html_report?: boolean; historical?: boolean; evidence_origin?: string; report_format?: number; derived_from?: string; simulation?: boolean }
+function usedTokens(usage?: Record<string, number>): number | undefined {
+  if (usage?.total_tokens != null) return usage.total_tokens;
+  if (usage?.input_tokens != null && usage?.output_tokens != null) return usage.input_tokens + usage.output_tokens;
+  return undefined;
+}
+function coordinatorCell(run: Run): Cell | undefined {
+  const saved = run.coordination;
+  if (!saved?.profile) return;
+  const stages = Object.values(saved.stages || {});
+  return { id: "coordinator", nombre: "Coordinador", estado: run.activity?.coordinator?.state || run.estado, ...saved.profile,
+    duration_seconds: stages.some(s => s.duration_seconds != null) ? stages.reduce((total, stage) => total + (stage.duration_seconds || 0), 0) : undefined,
+    usage: stages.length > 0 && stages.every(s => usedTokens(s.usage) != null) ? { total_tokens: stages.reduce((total, stage) => total + usedTokens(stage.usage)!, 0) } : undefined,
+    summary: saved.question_answers?.find(a => a.id === "Q01")?.respuesta,
+    error: stages.map(s => s.error).filter(Boolean).join(" · ") || undefined };
+}
+const busy = (state?: string) => state === "preparando" || state === "analizando";
+import { statusLabel as label, avatarStatus } from "./auditStatus";
+
+async function api(path: string, init?: RequestInit) {
+  const response = await fetch("/api/audit/" + path, { cache: "no-store", ...init });
+  const data = await response.json();
+  if (!response.ok) throw new Error(data.error || "No se pudo completar la solicitud.");
+  return data;
+}
+
+export function AuditOffice() {
+  const [roles, setRoles] = useState<Profile[]>([]);
+  const [repository, setRepository] = useState("");
+  const [sourceKind, setSourceKind] = useState("github");
+  const [localSources, setLocalSources] = useState<LocalSource[]>([]);
+  const [localSourceId, setLocalSourceId] = useState("");
+  const [runs, setRuns] = useState<Run[]>([]);
+  const [selected, setSelected] = useState<string | null>(null);
+  const [connected, setConnected] = useState(false);
+  const [error, setError] = useState("");
+  const [networkError, setNetworkError] = useState("");
+  const [submitting, setSubmitting] = useState(false);
+  const [panel, setPanel] = useState(true);
+  const [report, setReport] = useState<string | null>(null);
