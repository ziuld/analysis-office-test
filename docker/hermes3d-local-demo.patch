@@ -0,0 +1,115 @@
+"use client";
+import { useEffect, useState } from "react";
+
+export interface Question {
+  id: string; run_id: string; agent: string; nombre: string; question: string;
+  repository: string; commit: string | null; model: string | null; reasoning: string | null;
+  estado: string; respuesta?: string; certeza?: string; error?: string;
+  source?: string;
+  evidencia?: { path: string; line: number; quote: string }[];
+}
+interface Props {
+  run: { id: string; repository: string; commit?: string; branch?: string; estado: string };
+  agent: string; name: string; role?: string; active: Question | null; blocked: boolean;
+  onStarted: (q: Question) => void; onClose: () => void;
+  details?: { reason?: string; coverage?: string; error?: string; mensaje?: string; necesita?: string[]; missing?: string[]; summary?: string; model?: string; reasoning?: string; estado?: string };
+}
+
+// Display-only cache, scoped to this tab and to the selected review/agent.
+// Never used when building a model request. Memory also works if storage is blocked.
+const latestQuestions = new Map<string, Question>();
+function readLastQuestion(runId: string, agent: string): Question | null {
+  const key = `arktic:last-question:${runId}:${agent}`;
+  try {
+    const saved = latestQuestions.get(key) || JSON.parse(window.sessionStorage.getItem(key) || "null");
+    return saved?.run_id === runId && saved.agent === agent && typeof saved.question === "string" &&
+      typeof saved.id === "string" && ["en_cola", "respondiendo", "completada", "error"].includes(saved.estado) ? saved : null;
+  } catch { return latestQuestions.get(key) || null; }
+}
+function rememberQuestion(query: Question) {
+  const key = `arktic:last-question:${query.run_id}:${query.agent}`;
+  latestQuestions.set(key, query);
+  try { window.sessionStorage.setItem(key, JSON.stringify(query)); } catch { /* Memory fallback. */ }
+}
+
+export function AgentQuestion({ run, agent, name, role, active, blocked, details, onStarted, onClose }: Props) {
+  const [query, setQuery] = useState<Question | null>(() => readLastQuestion(run.id, agent));
+  const [text, setText] = useState(() => query?.question || "");
+  const [sending, setSending] = useState(false);
+  const [history, setHistory] = useState<Question[]>([]);
+  const [historyError, setHistoryError] = useState("");
+  useEffect(() => {
+    let cancelled = false;
+    fetch(`/api/audit/runs/${run.id}/questions/${agent}`, { cache: "no-store" }).then(async response => {
+      if (!response.ok) throw new Error();
+      const data = await response.json();
+      if (!cancelled) { setHistory(data.questions || []); setHistoryError(""); }
+    }).catch(() => { if (!cancelled) setHistoryError("Historial no disponible; no se reenvía ninguna pregunta."); });
+    return () => { cancelled = true; };
+  }, [run.id, agent, query?.id, query?.estado]);
+  const [error, setError] = useState("");
+  useEffect(() => { if (query) rememberQuestion(query); }, [query]);
+  useEffect(() => {
+    if (active?.run_id === run.id && active.agent === agent) setQuery(q => q?.id === active.id ? q : active);
+  }, [active, run.id, agent]);
+  useEffect(() => {
+    if (!query || !["en_cola", "respondiendo"].includes(query.estado)) return;
+    let stopped = false;
+    const refresh = async () => {
+      try {
+        const response = await fetch(`/api/audit/runs/${run.id}/questions/${query.id}`, { cache: "no-store" });
+        const data = await response.json();
+        if (!response.ok) throw new Error();
+        if (!stopped) { setQuery(data); setError(""); }
+      } catch { if (!stopped) setError("No se pudo leer el estado. La pregunta no se envía otra vez."); }
+    };
+    void refresh(); const timer = window.setInterval(() => void refresh(), 2000);
+    return () => { stopped = true; window.clearInterval(timer); };
+  }, [query?.id, query?.estado, run.id]);
+
+  async function ask(event: React.FormEvent) {
+    event.preventDefault(); setSending(true); setError("");
+    try {
+      const response = await fetch(`/api/audit/runs/${run.id}/questions`, {
+        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ agent, question: text }),
+      });
+      const data = await response.json();
+      if (!response.ok) throw new Error(data.error || "No se pudo enviar la consulta.");
+      setQuery(data); onStarted(data);
+    } catch (e) { setError(e instanceof Error ? e.message : "No se pudo enviar la consulta."); }
+    finally { setSending(false); }
+  }
+  const waiting = sending || query?.estado === "respondiendo" || query?.estado === "en_cola";
+  const certainty: Record<string, string> = { explicacion: "Explicación con fuentes", indicio: "Indicio por confirmar", sin_informacion: "Información insuficiente" };
+  return <div className="absolute inset-1 top-16 z-40 flex items-center justify-center bg-slate-950/80 p-2 sm:inset-x-3">
+    <section role="dialog" aria-modal="true" aria-label={name} className="flex max-h-full w-full max-w-5xl flex-col overflow-auto border-2 border-cyan-300/30 bg-slate-950 px-4 pb-5 text-slate-100 shadow-2xl sm:px-7">
+      <header className="sticky top-0 z-10 flex items-center justify-between gap-3 border-b border-white/10 bg-slate-950 py-4"><div><h2 className="font-mono text-xl font-bold text-cyan-100">{name}</h2>{role && <p className="mt-1 text-sm text-slate-300">{role}</p>}</div><button onClick={onClose} className="audit-pixel-button border-white/20 px-3 py-2 text-sm">Cerrar consulta</button></header>
+      <details className="mt-4 border border-white/15 bg-slate-900/50 p-3"><summary className="cursor-pointer text-sm text-slate-300">Perfil y detalles de la revisión</summary>
+        <p className="mt-3 break-all text-xs text-slate-400">{run.repository}<br />Revisión {run.id} · {run.branch || "main"}@{run.commit?.slice(0, 12) || "Sin commit"} · {run.estado}</p>
+        {details && <div className="mt-3 space-y-2 text-sm text-slate-300"><p>{details.reason}</p><p>Cobertura: {details.coverage || "No disponible"}</p><p>Modelo: {details.model || "No disponible"} · {details.reasoning || "No disponible"}</p></div>}
+      </details>
+      {details && (details.summary || details.mensaje || details.error || details.missing?.length || details.necesita?.length) && <details className="mt-3 border border-white/15 bg-slate-900/50 p-3"><summary className="cursor-pointer text-sm text-cyan-200">Resultado de la revisión</summary><div className="mt-3 space-y-3 whitespace-pre-wrap break-words text-sm leading-relaxed"><p>{details.summary}</p><p>{details.mensaje}</p>{details.error && <p className="text-rose-300">{details.error}</p>}<p>{[...(details.missing || []), ...(details.necesita || [])].join(" · ")}</p></div></details>}
+      <form onSubmit={ask} className="mt-4 space-y-3">
+        <label htmlFor="agent-question" className="block text-sm">Tu pregunta para {name}</label>
+        <p id="agent-question-help" className="text-xs leading-relaxed text-slate-400">Pregunta independiente sobre la evidencia guardada. Puedes leer las últimas 10 consultas guardadas de este personaje y revisión; no se envían como historial al modelo. No modifica el informe.</p>
+        <textarea id="agent-question" aria-describedby="agent-question-help" required maxLength={800} value={text} onChange={e => setText(e.target.value)} rows={4} className="w-full border border-white/20 bg-slate-900 p-3 text-sm" placeholder="¿Qué evidencia respalda esta observación?" />
+        <div className="flex flex-wrap items-center justify-between gap-3"><span className="text-xs text-slate-400">{text.length}/800 · Pregunta independiente</span><button disabled={waiting || blocked || !text.trim()} className="audit-pixel-button border-cyan-200/50 bg-[#42bcc6] px-4 py-2 text-sm font-semibold text-slate-950 disabled:opacity-40">{waiting ? "Consultando…" : "Enviar pregunta"}</button></div>
+      </form>
+      {blocked && !waiting && <p className="mt-3 text-sm text-amber-200">Espera a que termine la revisión o consulta activa.</p>}
+      {error && <p role="alert" className="mt-4 text-sm text-rose-300">{error}</p>}
+      {query && <div aria-live="polite" className="mt-5 space-y-3 border-t border-white/10 pt-4">
+        <h3 className="font-mono text-sm font-semibold text-slate-200">Última respuesta</h3>
+        <p className="text-xs text-slate-400">{query.nombre} · {query.source === "core" ? "Resuelto desde Core · sin llamada al modelo" : `${query.model || "No disponible"} / ${query.reasoning || "No disponible"}`}</p>
+        <p className="text-sm"><strong>Pregunta:</strong> {query.question}</p>
+        {query.estado === "en_cola" && <p>En cola · comenzará cuando quede libre la ejecución.</p>}
+        {query.estado === "respondiendo" && <p>Consultando la evidencia guardada…</p>}
+        {query.error && <p role="alert" className="text-sm text-rose-300">{query.error}</p>}
+        {query.respuesta && <><h3 className="font-semibold text-cyan-200">{certainty[query.certeza || ""] || "Respuesta"}</h3><p className="whitespace-pre-wrap text-sm leading-relaxed">{query.respuesta}</p>
+          {query.evidencia?.map((ref, i) => <div key={i} className="rounded-lg bg-slate-900 p-3 text-xs"><code>{ref.path}:{ref.line}</code><p className="mt-1 break-words text-slate-400">{ref.quote}</p></div>)}
+          <p className="text-xs text-slate-500">Referencias contrastadas con la evidencia guardada; la interpretación requiere revisión humana.</p></>}
+      </div>}
+      {historyError && <p role="status" className="mt-4 text-xs text-amber-200">{historyError}</p>}
+      {history.length > 0 && <details className="mt-5 border border-white/15 p-3"><summary className="cursor-pointer text-sm">Últimas consultas guardadas ({history.length})</summary><ul className="mt-3 space-y-3">{history.map(item => <li key={item.id}><details className="border-l-2 border-cyan-300/30 pl-3"><summary className="cursor-pointer break-words text-sm text-cyan-200">{item.question} · {item.estado}</summary><div className="mt-2 space-y-2 whitespace-pre-wrap break-words text-sm leading-relaxed"><p>{item.respuesta || item.error || "Sin respuesta guardada todavía."}</p>{item.evidencia?.map((ref, i) => <div key={i} className="bg-slate-900 p-3 text-xs"><code>{ref.path}:{ref.line}</code><p className="mt-1 text-slate-400">{ref.quote}</p></div>)}</div></details></li>)}</ul></details>}
+    </section>
+  </div>;
+}
