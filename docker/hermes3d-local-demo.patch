+++ b/tests/unit/agentQuestionCache.test.ts
@@ -0,0 +1,48 @@
+import React from "react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { AgentQuestion } from "@/features/audit/AgentQuestion";
+
+const props = (id: string, agent = "security") => ({
+  run: { id, repository: "https://github.com/acme/app", commit: "a".repeat(40), estado: "completo" },
+  agent, name: agent, active: null, blocked: false, onStarted: vi.fn(), onClose: vi.fn(),
+});
+afterEach(() => { cleanup(); vi.unstubAllGlobals(); });
+
+describe("last independent question", () => {
+  it("restores a completed answer after closing without another request and never submits history", async () => {
+    const first = props("cache-test-run-one");
+    const fetchMock = vi.fn().mockResolvedValue({ ok: true, json: async () => ({
+      id: "question-one", run_id: first.run.id, agent: "security", nombre: "Seguridad", question: "Primera pregunta",
+      repository: first.run.repository, commit: first.run.commit, model: "test", reasoning: "low",
+      estado: "completada", respuesta: "Respuesta guardada", certeza: "sin_informacion", evidencia: [],
+    }) });
+    vi.stubGlobal("fetch", fetchMock);
+    const view = render(React.createElement(AgentQuestion, first));
+    fireEvent.change(screen.getByRole("textbox"), { target: { value: "Primera pregunta" } });
+    fireEvent.click(screen.getByRole("button", { name: "Enviar pregunta" }));
+    await screen.findByText("Respuesta guardada");
+    view.unmount();
+    render(React.createElement(AgentQuestion, first));
+    expect(screen.getByText("Respuesta guardada")).toBeInTheDocument();
+    expect(screen.getByRole("textbox")).toHaveValue("Primera pregunta");
+    expect(fetchMock.mock.calls.filter(call => call[1]?.method === "POST")).toHaveLength(1);
+    fireEvent.change(screen.getByRole("textbox"), { target: { value: "Segunda pregunta" } });
+    fireEvent.click(screen.getByRole("button", { name: "Enviar pregunta" }));
+    await waitFor(() => expect(fetchMock.mock.calls.filter(call => call[1]?.method === "POST")).toHaveLength(2));
+    expect(JSON.parse(fetchMock.mock.calls.filter(call => call[1]?.method === "POST")[1][1].body)).toEqual({ agent: "security", question: "Segunda pregunta" });
+  });
+
+  it("isolates restored answers by review and agent", () => {
+    const saved = { id: "q", run_id: "cache-test-run-two", agent: "security", question: "Pregunta de seguridad", estado: "completada", respuesta: "Respuesta privada de esa revisión" };
+    window.sessionStorage.setItem("arktic:last-question:cache-test-run-two:security", JSON.stringify(saved));
+    const view = render(React.createElement(AgentQuestion, props(saved.run_id)));
+    expect(screen.getByText(saved.respuesta)).toBeInTheDocument();
+    view.unmount();
+    const other = render(React.createElement(AgentQuestion, props(saved.run_id, "inventory")));
+    expect(screen.queryByText(saved.respuesta)).not.toBeInTheDocument();
+    other.unmount();
+    render(React.createElement(AgentQuestion, props("cache-test-run-three")));
+    expect(screen.queryByText(saved.respuesta)).not.toBeInTheDocument();
+  });
+});
diff --git a/tests/unit/arkticOfficeMap.test.ts b/tests/unit/arkticOfficeMap.test.ts
new file mode 100644
index 0000000..8fb984e
--- /dev/null
+++ b/tests/unit/arkticOfficeMap.test.ts
@@ -0,0 +1,67 @@
+import { describe, expect, it } from "vitest";
+import { buildArkticOfficeMap } from "@/features/pixel-office/map/arkticOfficeMap";
+import { buildPixelNavGrid, tileCenter } from "@/features/pixel-office/map/navGrid";
+import { createPixelSimulation } from "@/features/pixel-office/sim/agentSimulation";
+import { OBJECT_FOOTPRINT, type PixelAgentInput } from "@/features/pixel-office/types";
+import { astar2D } from "@/lib/office/pathfinding";
+
+describe("compact Arktic office", () => {
+  it("keeps furniture within the map and outside the enclosing walls", () => {
+    const map = buildArkticOfficeMap();
+    for (const object of map.objects) {
+      const [w, h] = OBJECT_FOOTPRINT[object.kind];
+      expect(object.tx).toBeGreaterThan(1);
+      expect(object.ty).toBeGreaterThan(1);
+      expect(object.tx + w).toBeLessThanOrEqual(map.cols - 2);
+      expect(object.ty + h).toBeLessThanOrEqual(map.rows - 2);
+    }
+  });
+
+  it("connects all four desks and every room station to the entrance", () => {
+    const map = buildArkticOfficeMap();
+    expect(map.desks).toHaveLength(4);
+    const grid = buildPixelNavGrid(map);
+    const start = tileCenter(map.spawn.tx, map.spawn.ty);
+    const targets = [...map.stations.map(s => [s.tx, s.ty]), ...map.desks.map(d => [d.seatTx, d.seatTy])];
+    for (const [tx, ty] of targets) {
+      const end = tileCenter(tx, ty);
+      expect(astar2D(start.x, start.y, end.x, end.y, grid).length, `unreachable ${tx},${ty}`).toBeGreaterThan(0);
+    }
+  });
+
+  it("lets the four working agents reach different computer seats", () => {
+    const sim = createPixelSimulation(buildArkticOfficeMap());
+    const inputs: PixelAgentInput[] = ["coordinator", "security", "architecture", "inventory"].map(id => ({
+      id, name: id, color: "#42bcc6", status: "working", streaming: false,
+      thinking: false, awaitingApproval: false, dancing: false, hold: null, standup: false,
+    }));
+    let poses = sim.tick({ inputs, nowMs: 100000, dtMs: 50, cleaningActive: false });
+    for (let tick = 1; tick < 1600; tick++)
+      poses = sim.tick({ inputs, nowMs: 100000 + tick * 50, dtMs: 50, cleaningActive: false });
+    expect(poses).toHaveLength(4);
+    expect(poses.every(p => p.activity === "sitting_desk" && !p.moving)).toBe(true);
+    expect(new Set(poses.map(p => p.deskId)).size).toBe(4);
+  });
+
+  it("keeps desk orientation during work and releases finished agents", () => {
+    for (const finishedStatus of ["idle", "error"] as const) {
+      const sim = createPixelSimulation(buildArkticOfficeMap());
+      const inputs: PixelAgentInput[] = ["coordinator", "security"].map(id => ({
+        id, name: id, color: "#42bcc6", status: "working", controlled: true, selected: false,
+        streaming: false, thinking: false, awaitingApproval: false, dancing: false, hold: null, standup: false,
+      }));
+      let poses = sim.tick({ inputs, nowMs: 0, dtMs: 50, cleaningActive: false });
+      for (let tick = 1; tick < 1000; tick++) poses = sim.tick({ inputs, nowMs: tick * 50, dtMs: 50, cleaningActive: false });
+      const parked = poses.map(p => [p.x, p.y]);
+      const facing = poses.map(p => p.facing);
+      inputs[1].selected = true;
+      for (let tick = 1000; tick < 1200; tick++) poses = sim.tick({ inputs, nowMs: tick * 50, dtMs: 50, cleaningActive: false });
+      expect(poses.map(p => [p.x, p.y])).toEqual(parked);
+      expect(poses.map(p => p.facing)).toEqual(facing);
+      for (const input of inputs) input.status = finishedStatus;
+      for (let tick = 1200; tick < 2200; tick++) poses = sim.tick({ inputs, nowMs: tick * 50, dtMs: 50, cleaningActive: false });
+      expect(poses.map(p => [p.x, p.y])).not.toEqual(parked);
+      expect(poses.every(p => p.activity !== "sitting_desk")).toBe(true);
+    }
+  });
+});
