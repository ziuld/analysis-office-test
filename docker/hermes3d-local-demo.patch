+import React from "react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { ExecutiveReport } from "@/features/audit/ExecutiveReport";
+
+afterEach(cleanup);
+
+describe("executive security report", () => {
+  it("shows the report directly without filters or print controls, and disables scripts", () => {
+    render(React.createElement(ExecutiveReport, { html: "<html><head></head><body>complete evidence</body></html>" }));
+    expect(screen.queryByLabelText("Ver riesgos")).toBeNull();
+    expect(screen.queryByRole("button", { name: "Imprimir / guardar PDF" })).toBeNull();
+    const frame = screen.getByTitle("Informe de revisión") as HTMLIFrameElement;
+    expect(frame.getAttribute("srcdoc")).toContain("complete evidence");
+    expect(frame.getAttribute("sandbox")).not.toContain("allow-scripts");
+  });
+
+  it("navigation reveals nested evidence and keeps the return context without running report scripts", () => {
+    render(React.createElement(ExecutiveReport, { html: '<html><head></head><body><script id="arktic-report-navigation">unsafe()</script></body></html>' }));
+    const frame = screen.getByTitle("Informe de revisión") as HTMLIFrameElement;
+    expect(frame.getAttribute("srcdoc")).not.toContain("unsafe()");
+    frame.contentDocument!.body.innerHTML = '<section class="chapter" id="anexos"><details id="registro"><summary>Registro</summary><article id="R01"><details id="tecnico-R01"><summary>Técnico</summary><p id="fuente">Fuente</p></details></article></details></section><div id="resumen-R01">Contexto</div><a href="#fuente">Ver fuente</a><a href="#resumen-R01">Volver</a>';
+    const source = frame.contentDocument!.getElementById("fuente")!;
+    const context = frame.contentDocument!.getElementById("resumen-R01")!;
+    source.scrollIntoView = vi.fn();
+    context.scrollIntoView = vi.fn();
+    fireEvent.load(frame);
+    const anchors = frame.contentDocument!.querySelectorAll("a");
+    fireEvent.click(anchors[0]);
+    expect((frame.contentDocument!.getElementById("registro") as HTMLDetailsElement).open).toBe(true);
+    expect((frame.contentDocument!.getElementById("tecnico-R01") as HTMLDetailsElement).open).toBe(true);
+    expect(source.scrollIntoView).toHaveBeenCalled();
+    fireEvent.click(anchors[1]);
+    expect(context.scrollIntoView).toHaveBeenCalled();
+    expect(frame.getAttribute("sandbox")).not.toContain("allow-scripts");
+  });
+
+});
diff --git a/src/features/pixel-office/sim/ambientConversations.ts b/src/features/pixel-office/sim/ambientConversations.ts
new file mode 100644
--- /dev/null
+++ b/src/features/pixel-office/sim/ambientConversations.ts
@@ -0,0 +1,75 @@
+import { PIXEL_TILE_SIZE, type PixelAgentInput, type PixelAgentPose, type PixelFacing } from "@/features/pixel-office/types";
+
+type Conversation = { ids: [string, string]; desktop: boolean; startedAt: number; endsAt: number };
+export type AmbientCue = { text: string; alpha: number; facing?: PixelFacing };
+
+/** Visual-only exchanges. Never writes agent status, history or model requests. */
+export function createAmbientConversations(random: () => number = Math.random) {
+  let active: Conversation | null = null;
+  let nextAt: number | null = null;
+  const delay = () => 18000 + random() * 17000;
+  return {
+    tick(nowMs: number, inputs: PixelAgentInput[], poses: PixelAgentPose[], blocked: Set<string>, pauseUntil: Record<string, number> = {}) {
+      const cues = new Map<string, AmbientCue>();
+      const inputById = new Map(inputs.map(input => [input.id, input]));
+      const available = poses.filter(pose => {
+        const input = inputById.get(pose.id);
+        return input?.status === "idle" && !input.standup && !input.hold && !input.dancing && !input.thinking &&
+          !input.streaming && !input.awaitingApproval && !pose.moving && !blocked.has(pose.id) &&
+          ["sitting_desk", "standing", "station"].includes(pose.activity);
+      });
+      const byId = new Map(available.map(pose => [pose.id, pose]));
+      const closeEnough = (a: PixelAgentPose, b: PixelAgentPose) => Math.hypot(a.x - b.x, a.y - b.y) <= PIXEL_TILE_SIZE * 3.5;
+      // A meeting anywhere in the office silences ambient exchanges immediately.
+      const meeting = inputs.some(input => input.standup);
+      if (active) {
+        const a = byId.get(active.ids[0]), b = byId.get(active.ids[1]);
+        if (nowMs >= active.endsAt || meeting || !a || !b ||
+          (a.activity === "sitting_desk") !== active.desktop || (b.activity === "sitting_desk") !== active.desktop ||
+          (!active.desktop && !closeEnough(a, b))) {
+          active = null;
+          nextAt = nowMs + delay();
+        }
+      }
+      if (nextAt === null) nextAt = nowMs + 5000 + random() * 5000;
+      if (!active && !meeting && nowMs >= nextAt) {
+        const pairs: [PixelAgentPose, PixelAgentPose][] = [];
+        for (let i = 0; i < available.length; i++) for (let j = i + 1; j < available.length; j++) {
+          const a = available[i], b = available[j];
+          const desktop = a.activity === "sitting_desk";
+          if (desktop !== (b.activity === "sitting_desk")) continue;
+          if (desktop || closeEnough(a, b)) pairs.push([a, b]);
+        }
+        const duration = (desktop: boolean) => desktop ? 25000 + random() * 20000 : 8000 + random() * 7000;
+        if (pairs.length) {
+          const [a, b] = pairs[Math.min(pairs.length - 1, Math.floor(random() * pairs.length))];
+          const desktop = a.activity === "sitting_desk", endsAt = nowMs + duration(desktop);
+          // Do not start a long chat just before either participant leaves the PC.
+          if (!desktop || [a, b].every(p => (pauseUntil[p.id] ?? Infinity) >= endsAt)) {
+            active = { ids: [a.id, b.id], desktop, startedAt: nowMs, endsAt };
+          }
+        }
+        if (!active) nextAt = nowMs + 2000;
+      }
+      if (active) {
+        const turnMs = active.desktop ? 6000 : 2800;
+        const elapsed = nowMs - active.startedAt;
+        const turn = Math.floor(elapsed / turnMs), phase = elapsed % turnMs;
+        for (const [index, id] of active.ids.entries()) {
+          const pose = byId.get(id)!, other = byId.get(active.ids[1 - index])!;
+          let facing: PixelFacing | undefined;
+          if (!active.desktop) {
+            const dx = other.x - pose.x, dy = other.y - pose.y;
+            facing = Math.abs(dx) > Math.abs(dy) ? dx > 0 ? "right" : "left" : dy > 0 ? "down" : "up";
+          }
+          const visibleMs = active.desktop ? 2200 : 1700;
+          const speaking = index === turn % 2 && phase < visibleMs;
+          const alpha = speaking ? Math.min(1, phase / 200, (visibleMs - phase) / 250) : 0;
+          cues.set(id, { text: speaking ? ["…", "?", "…", "!"][turn % 4] : "", alpha, facing });
+        }
+      }
+      return cues;
+    },
+    getState: () => active,
+  };
+}
diff --git a/tests/unit/ambientConversations.test.ts b/tests/unit/ambientConversations.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/unit/ambientConversations.test.ts
@@ -0,0 +1,63 @@
+import { describe, expect, it } from "vitest";
+import { createAmbientConversations } from "@/features/pixel-office/sim/ambientConversations";
+import type { PixelAgentInput, PixelAgentPose } from "@/features/pixel-office/types";
+
+const inputs = (): PixelAgentInput[] => ["a", "b"].map(id => ({id, name:id, color:"#fff", status:"idle", controlled:true,
+  streaming:false, thinking:false, awaitingApproval:false, dancing:false, hold:null, standup:false}));
+const poses = (desktop = false): PixelAgentPose[] => ["a", "b"].map((id, i) => ({id, x:100 + i * (desktop ? 300 : 50), y:100,
+  facing:"up", activity:desktop ? "sitting_desk" : "standing", moving:false, stationId:null, deskId:desktop ? id : null}));
+
+describe("ambient conversations", () => {
+  it("uses longer desktop exchanges, alternating bubbles and silent pauses without turning away", () => {
+    const chat = createAmbientConversations(() => 0), people = inputs(), seated = poses(true);
+    chat.tick(0, people, seated, new Set());
+    const first = chat.tick(5000, people, seated, new Set());
+    expect(chat.getState()?.endsAt).toBe(30000);
+    expect(first.get("a")?.text).toBe("…");
+    expect(first.get("b")?.text).toBe("");
+    expect(first.get("a")?.facing).toBeUndefined();
+    expect([...chat.tick(8000, people, seated, new Set()).values()].every(cue => !cue.text)).toBe(true);
+    expect(chat.tick(11000, people, seated, new Set()).get("b")?.text).toBe("?");
+    chat.tick(30000, people, seated, new Set());
+    expect(chat.getState()).toBeNull();
+    expect(people.every(person => person.status === "idle")).toBe(true);
+  });
+
+  it("faces nearby partners during a shorter local exchange and cancels on movement", () => {
+    const chat = createAmbientConversations(() => 0), people = inputs(), standing = poses();
+    chat.tick(0, people, standing, new Set());
+    const cues = chat.tick(5000, people, standing, new Set());
+    expect(chat.getState()?.endsAt).toBe(13000);
+    expect(cues.get("a")?.facing).toBe("right");
+    expect(cues.get("b")?.facing).toBe("left");
+    standing[0].moving = true;
+    expect(chat.tick(5100, people, standing, new Set()).size).toBe(0);
+    expect(chat.getState()).toBeNull();
+  });
+
+  it("gives real work, messages, thinking, holds and meetings immediate priority", () => {
+    for (const interrupt of ["work", "message", "thinking", "hold", "meeting", "removed"] as const) {
+      const chat = createAmbientConversations(() => 0), people = inputs(), seated = poses(true);
+      chat.tick(0, people, seated, new Set());
+      chat.tick(5000, people, seated, new Set());
+      expect(chat.getState()).not.toBeNull();
+      const blocked = new Set<string>();
+      if (interrupt === "work") people[0].status = "working";
+      if (interrupt === "message") blocked.add("a");
+      if (interrupt === "thinking") people[0].thinking = true;
+      if (interrupt === "hold") people[0].hold = "phone_booth";
+      if (interrupt === "meeting") people.push({...people[0], id:"c", standup:true});
+      if (interrupt === "removed") people.shift();
+      expect(chat.tick(5100, people, seated, blocked).size, interrupt).toBe(0);
+      expect(chat.getState()).toBeNull();
+    }
+  });
+
+  it("does not start across distant common areas or just before leaving a desk", () => {
+    const chat = createAmbientConversations(() => 0), people = inputs(), standing = poses();
+    standing[1].x = 800;
+    chat.tick(0, people, standing, new Set());
+    expect(chat.tick(5000, people, standing, new Set()).size).toBe(0);
+    expect(chat.tick(7000, people, poses(true), new Set(), {a:8000, b:8000}).size).toBe(0);
+  });
+});
