+import { describe, expect, it } from "vitest";
+import { avatarStatus, statusLabel } from "@/features/audit/auditStatus";
+
+describe("terminal information outcomes", () => {
+  it("finishes insufficient and partial outcomes without a red or working avatar", () => {
+    for (const state of ["informacion_insuficiente", "sin_evidencia", "parcial", "completada"]) {
+      expect(avatarStatus(true, state)).toBe("idle");
+    }
+    expect(statusLabel.informacion_insuficiente).toBe("Información insuficiente");
+  });
+  it("keeps real technical errors and active work distinct", () => {
+    expect(avatarStatus(true, "error")).toBe("error");
+    expect(avatarStatus(false, "completada")).toBe("error");
+    expect(avatarStatus(true, "analizando")).toBe("working");
+  });
+});
