diff --git a/src/features/audit/ExecutiveReport.tsx b/src/features/audit/ExecutiveReport.tsx
new file mode 100644
index 0000000..a092ac7
--- /dev/null
+++ b/src/features/audit/ExecutiveReport.tsx
@@ -0,0 +1,33 @@
+"use client";
+
+import React, { useRef } from "react";
+
+export function ExecutiveReport({ html }: { html: string }) {
+  const frame = useRef<HTMLIFrameElement>(null);
+  const source = html.replace(/<script id="arktic-report-navigation">[\s\S]*?<\/script>/g, "");
+  function bindNavigation() {
+    const doc = frame.current?.contentDocument;
+    if (!doc) return;
+    // The iframe cannot run scripts. This trusted parent handles internal anchors only.
+    doc.addEventListener("click", event => {
+      const anchor = (event.target as Element)?.closest?.('a[href^="#"]');
+      const href = anchor?.getAttribute("href");
+      if (!href) return;
+      let id;
+      try { id = decodeURIComponent(href.slice(1)); } catch { return; }
+      const target = doc.getElementById(id);
+      if (!target) return;
+      event.preventDefault();
+      for (let node: HTMLElement | null = target; node; node = node.parentElement) {
+        if (node.tagName === "DETAILS") (node as HTMLDetailsElement).open = true;
+        if (node.classList.contains("risk")) node.style.display = node.tagName === "TR" ? "table-row" : "block";
+      }
+      target.scrollIntoView({ block: "start" });
+      doc.querySelectorAll(".nav a").forEach(item => item.removeAttribute("aria-current"));
+      doc.querySelector(`.nav a[href="#${target.closest(".chapter")?.id || id}"]`)?.setAttribute("aria-current", "location");
+    });
+  }
+  return <div className="flex min-h-0 flex-1 flex-col gap-3">
+    <iframe ref={frame} onLoad={bindNavigation} title="Informe de revisión" sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox" srcDoc={source} className="min-h-0 flex-1 rounded-lg border-0 bg-white" />
+  </div>;
+}
