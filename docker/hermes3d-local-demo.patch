@@ -0,0 +1,73 @@
+// Compact consulting office. Grow this map when a real team needs more seats.
+// Reuses the upstream furniture, navigation and character simulation.
+import type { PixelGroundTile, PixelMapObject, PixelObjectKind, PixelOfficeMap } from "@/features/pixel-office/types";
+
+export const buildArkticOfficeMap = (): PixelOfficeMap => {
+  const cols = 28, rows = 22;
+  const ground: PixelGroundTile[] = new Array(cols * rows).fill("void");
+  const rect = (tile: PixelGroundTile, x: number, y: number, w: number, h: number) => {
+    for (let ty = y; ty < y + h; ty++)
+      for (let tx = x; tx < x + w; tx++) ground[ty * cols + tx] = tile;
+  };
+  rect("floor_cream", 2, 2, 24, 18);
+  rect("floor_white", 2, 2, 15, 16);
+  rect("floor_wood", 18, 2, 8, 9);
+  rect("kitchen_tile", 18, 12, 8, 6);
+  rect("wall", 1, 1, 26, 1);
+  rect("wall", 1, 20, 26, 1);
+  rect("wall", 1, 2, 1, 18);
+  rect("wall", 26, 2, 1, 18);
+  rect("wall", 17, 2, 1, 16);
+  rect("wall", 18, 11, 8, 1);
+  // Generous doorways connect every room to the shared circulation space.
+  rect("floor_cream", 17, 8, 1, 2);
+  rect("floor_cream", 17, 15, 1, 2);
+  rect("path", 8, 20, 3, 1);
+  for (const x of [4, 5, 10, 11, 20, 21, 23, 24]) rect("wall_window", x, 1, 1, 1);
+
+  const objects: PixelMapObject[] = [];
+  const put = (kind: PixelObjectKind, tx: number, ty: number, blocking?: boolean) =>
+    objects.push({ id: `${kind}-${tx}-${ty}`, kind, tx, ty, ...(blocking === undefined ? {} : { blocking }) });
+  const desks = [[5, 6], [11, 6], [5, 12], [11, 12]].map(([x, y], i) => {
+    put("desk_monitor", x, y);
+    put("chair", x, y + 1, false);
+    return { id: `arktic-desk-${i + 1}`, deskTx: x, deskTy: y, seatTx: x, seatTy: y + 1, facing: "up" as const };
+  });
+  put("plant_tall", 2, 2);
+  put("plant", 15, 16);
+  put("bookshelf", 3, 16);
