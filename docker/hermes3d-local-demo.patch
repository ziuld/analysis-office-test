+export const statusLabel: Record<string, string> = {
+  en_cola: "En cola", bloqueado: "Bloqueado", respondiendo: "Respondiendo",
+  no_participo: "No participó",
+  simulacion: "Simulación", simulada: "Simulada", preparando: "Leyendo repositorio",
+  analizando: "Analizando", pendiente: "Pendiente", completada: "Completada",
+  completo: "Completado", parcial: "Resultado parcial", error: "Error técnico",
+  sin_evidencia: "Información insuficiente", informacion_insuficiente: "Información insuficiente",
+  no_ejecutado: "Omitido con justificación",
+  sin_resultados: "Sin resultados válidos",
+};
+
+export function avatarStatus(connected: boolean, state?: string): "error" | "working" | "idle" {
+  if (!connected || state === "error") return "error";
+  if (state === "preparando" || state === "analizando") return "working";
+  return "idle";
+}
